# Apache rules for https://dhemmynfood.mimmycare.com (document root ~/dhemmynfood.mimmycare.com).
# Copied into dist/ by the build and uploaded by release.json (the dist part allows .htaccess).
# Base: ~/Developer/build-kit/App-Kit/starter/public/.htaccess, plus the security headers that were in
# the Netlify _headers file (docs/05-security/SECURITY.md). This web root is dedicated to this site.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hidden files (.git, .env, .htaccess itself) are never served. /.well-known/ stays open for AutoSSL.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # Never send the API to the SPA fallback. api/.htaccess has its own rules.
  RewriteRule ^api(?:/|$) - [L]

  # Deep links: serve index.html for anything that is not a real file or folder.
  # Real files (robots.txt, sitemap.xml, share.jpg, /assets/*) are still served as themselves.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always unset X-Powered-By
  # Strict-Transport-Security is left out on purpose, as before: add it only once HTTPS is proven on
  # the live address (docs/05-security/SECURITY.md).

  # Entry files must always be revalidated so updates reach users.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|build-id\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Hashed build assets never change, so cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
